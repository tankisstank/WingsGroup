268	          : `Xuất bản TourProduct #${readiness.product.id}, Page #${readiness.wrapper?.id || '—'} (${readiness.wrapper?.path || readiness.product.expectedPath || '—'}) và các lịch ${departureIDs.map((departureID) => `#${departureID}`).join(', ')}?`,
269	      )
