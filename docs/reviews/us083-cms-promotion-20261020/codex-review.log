export { default as TourDepartureManager } from './TourDepartureManager'
export * from './types'

export default function TourProductAuthoring() {
  const [departureRevision, setDepartureRevision] = useState(0)
  const { data } = useDocumentInfo()
  const { code: locale } = useLocale()
  const formModified = useFormModified()
  const { value: draftSlug } = useField<string>({ path: 'slug' })
  const site = data?.site as { code?: string; name?: string; id?: number | string } | number | string | undefined
  const siteCode = tourAuthoringSiteCode(site)
  const siteID = tourAuthoringRelationID(site)
  const savedSlug = typeof data?.slug === 'string' ? data.slug : null
  const currentWrapperPath = data?.wrapperPage && typeof data.wrapperPage === 'object' && 'pathname' in data.wrapperPage
    ? (data.wrapperPage as { pathname?: unknown }).pathname
    : null
  const slugChanged = formModified && typeof draftSlug === 'string' && draftSlug.trim() && savedSlug && draftSlug !== savedSlug

  return <section aria-label="Tour authoring" className="tour-authoring-workspace" id="tour-authoring">
    <div className="tour-authoring-context">
      <div>
        <span className="tour-authoring-context__eyebrow">QUẢN TRỊ TOUR</span>
        <strong>Luồng tạo, kiểm tra và xuất bản</strong>
        <p>Thực hiện lần lượt các bước bên dưới. Trạng thái và lỗi kỹ thuật sẽ hiển thị ngay trong khu vực Lịch bay & xuất bản.</p>
      </div>
      <div className="tour-authoring-context__meta">
        <span>Site: <b>{typeof site === 'object' ? site.name || site.code || `#${siteID || 'chưa chọn'}` : siteID ? `#${siteID}` : 'chưa chọn'}</b></span>
        <span>Ngôn ngữ: <b>{locale || 'vi'}</b></span>
      </div>
      <p className="tour-authoring-context__site-note">{siteCode === 'wings-go' ? 'WingsGo: trường phân loại WingSide được ẩn; dữ liệu cũ vẫn được giữ.' : siteCode === 'wing-side' ? 'WingSide: trường phân loại tour được hiển thị.' : 'Chọn site trước khi nhập nội dung để xác định website và quyền xuất bản.'}</p>
      {!siteID && <p className="tour-authoring-context__warning" role="alert">Chưa chọn site. Hãy chọn site tại trường Site trước khi lưu tour.</p>}
      {formModified && <p className="tour-authoring-context__warning" role="status">Có thay đổi chưa lưu. Lưu TourProduct trước khi dùng Preview, tạo wrapper hoặc kiểm tra readiness.</p>}
      {slugChanged && <p className="tour-authoring-context__warning" role="alert">Slug đang đổi từ <b>/tour/{savedSlug}</b> thành <b>/tour/{draftSlug}</b>. Wrapper hiện tại {typeof currentWrapperPath === 'string' ? <b>{currentWrapperPath}</b> : 'chưa có'} không tự đổi pathname. Lưu tour, sau đó tạo/gán wrapper đúng đường dẫn.</p>}
    </div>
    <TourDepartureManager onSaved={() => setDepartureRevision((revision) => revision + 1)} />
    <TourAuthoringReadiness departureRevision={departureRevision} />
  </section>
}
import { isDepartureVerificationCurrent } from '@/tours/departureCommerce'

export type TourAuthoringRelation = number | string | { id?: number | string | null } | null | undefined

export type TourAuthoringSite = {
  code?: string | null
  id: number | string
  name?: string | null
}

export type TourAuthoringSiteState =
  | { kind: 'none'; message: string }
  | { kind: 'fixed'; siteID: number | string; siteName: string }
  | { kind: 'choose'; siteIDs: Array<number | string> }

export const tourAuthoringRelationID = (value: TourAuthoringRelation): number | string | undefined => {
  if (typeof value === 'number' || typeof value === 'string') return value
  return value?.id == null ? undefined : value.id
}

export const tourAuthoringSiteCode = (value: TourAuthoringRelation | Partial<TourAuthoringSite>): string | undefined => {
  return typeof value === 'object' && value && 'code' in value && value.code ? value.code : undefined
}

export const getTourAuthoringSiteState = ({
  currentSite,
  isNew,
  userSiteIDs,
}: {
  currentSite?: TourAuthoringRelation
  isNew: boolean
  userSiteIDs: Array<number | string>
}): TourAuthoringSiteState => {
  const currentSiteID = tourAuthoringRelationID(currentSite)
  if (!isNew && currentSiteID !== undefined) {
    return { kind: 'fixed', siteID: currentSiteID, siteName: 'Site hiện tại' }
  }
  if (userSiteIDs.length === 1) {
    return { kind: 'fixed', siteID: userSiteIDs[0], siteName: 'Site được phân quyền' }
  }
  if (userSiteIDs.length > 1) return { kind: 'choose', siteIDs: userSiteIDs }
  return { kind: 'none', message: 'Tài khoản chưa được gán site.' }
}

export const getTourAuthoringTourTypePresentation = (siteCode?: string) => ({
  hidden: siteCode === 'wings-go',
  label: siteCode === 'wing-side' ? 'Loại tour WingSide' : 'Phân loại tour',
})

export const parseTourAuthoringPrice = (value: unknown, currency = 'VND'): number | null => {
  if (typeof value === 'number') return Number.isFinite(value) && value >= 0 ? value : null
  if (typeof value !== 'string' || !value.trim()) return null

  const input = value.trim()
  if (currency === 'VND' && (/^\d{1,3}(?:[.,]\d{3})+$/u.test(input) || /^\d+$/u.test(input))) {
    const parsed = Number(input.replace(/[.,]/gu, ''))
    return Number.isSafeInteger(parsed) && parsed >= 0 ? parsed : null
  }
  if (currency === 'VND') return null

  const parsed = Number(input)
  return Number.isFinite(parsed) && parsed >= 0 ? parsed : null
}

export type TourAuthoringFreshness = 'current' | 'needs-verification' | 'expired'

export const getTourAuthoringFreshness = (
  departure: { expiresAt?: null | string; verifiedAt?: null | string },
  now = Date.now(),
): TourAuthoringFreshness => {
  if (departure.expiresAt && Date.parse(departure.expiresAt) <= now) return 'expired'
  return isDepartureVerificationCurrent(departure, now) ? 'current' : 'needs-verification'
}

export const normalizeTourAuthoringRelations = (value: unknown): Array<number | string> => {
  if (!Array.isArray(value)) return []
  return value
    .map((item) => tourAuthoringRelationID(item as TourAuthoringRelation))
    .filter((item): item is number | string => item !== undefined)
}

export const buildTourAuthoringDepartureQuery = (productID: number | string, siteID: number | string) => {
  const params = new URLSearchParams({
    depth: '1',
    limit: '100',
    sort: 'departureDate',
  })
  params.set('where[tourProduct][equals]', String(productID))
  params.set('where[site][equals]', String(siteID))
  return `/api/tour-departures?${params.toString()}`
}

