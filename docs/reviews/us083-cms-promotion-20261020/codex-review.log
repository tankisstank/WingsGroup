import React from 'react'
import { afterEach, describe, expect, it, vi } from 'vitest'

const uiMocks = vi.hoisted(() => ({
  documentId: 41,
  documentSite: 2,
  localeCode: 'vi',
  setValue: vi.fn(),
}))

vi.mock('@payloadcms/ui', () => ({
  FieldError: () => null,
  FieldLabel: ({ label }: { label?: string }) => React.createElement('label', null, label),
  useAuth: () => ({ user: { role: 'super-admin', sites: [1, 2] } }),
  useDocumentInfo: () => ({ data: { site: uiMocks.documentSite }, id: uiMocks.documentId }),
  useField: () => ({ errorMessage: null, setValue: uiMocks.setValue, showError: false, value: null }),
  useFormModified: () => false,
  useLocale: () => ({ code: uiMocks.localeCode }),
}))

import TourDepartureManager, {
  type DepartureFormValue,
  TourDepartureForm,
} from '@/components/TourAuthoring/TourDepartureManager'

afterEach(() => {
  cleanup()
  uiMocks.setValue.mockReset()
  uiMocks.localeCode = 'vi'
  vi.unstubAllGlobals()
})

const defaultInitial: DepartureFormValue = {
  airline: '',
  availabilityStatus: 'open',
  currency: 'VND',
  departureCity: '',
  departureDate: '2026-11-01',
  expiresAt: '',
  originalPrice: '',
  priceFrom: '10000000',
  promoLabel: '',
  promotionEnabled: false,
  verified: false,
}

const mockResponse = (body: unknown, status = 200) => ({
  json: async () => body,
  ok: status < 400,
  status,
})

describe('US083 CMS Tour Departure Promotion - Component Tests', () => {
  describe('TourDepartureForm - Toggle and Field Visibility', () => {
    it('defaults promotion fields to hidden/disabled and toggles inputs on checkbox change', () => {
      render(
        <TourDepartureForm
          initial={defaultInitial}
          onCancel={vi.fn()}
          onSubmit={vi.fn()}
        />,
      )

      const toggle = screen.getByLabelText('Áp dụng ưu đãi') as HTMLInputElement
      expect(toggle.checked).toBe(false)
      expect(screen.queryByLabelText('Giá gốc')).toBeNull()
      expect(screen.queryByLabelText('Nhãn promotion')).toBeNull()

      fireEvent.click(toggle)
      expect(toggle.checked).toBe(true)
      expect(screen.getByLabelText('Giá gốc')).toBeTruthy()
      expect(screen.getByLabelText('Nhãn promotion')).toBeTruthy()

      fireEvent.click(toggle)
      expect(toggle.checked).toBe(false)
      expect(screen.queryByLabelText('Giá gốc')).toBeNull()
      expect(screen.queryByLabelText('Nhãn promotion')).toBeNull()
    })
  })

  describe('TourDepartureForm - Validation & Price Bounds', () => {
    it('requires at least originalPrice or non-blank promoLabel when promotion is enabled', async () => {
      const onSubmit = vi.fn()
      render(
        <TourDepartureForm
          initial={defaultInitial}
          onCancel={vi.fn()}
          onSubmit={onSubmit}
        />,
      )

      fireEvent.click(screen.getByLabelText('Áp dụng ưu đãi'))
      fireEvent.click(screen.getByRole('button', { name: 'Lưu lịch khởi hành' }))

      expect(screen.getByRole('alert').textContent).toContain('Nhập giá gốc hoặc nhãn promotion cho ưu đãi.')
      expect(onSubmit).not.toHaveBeenCalled()
    })

    it('rejects invalid non-numeric originalPrice text or originalPrice not greater than sale price', async () => {
      const onSubmit = vi.fn()
      render(
        <TourDepartureForm
          initial={defaultInitial}
          onCancel={vi.fn()}
          onSubmit={onSubmit}
        />,
      )

      fireEvent.click(screen.getByLabelText('Áp dụng ưu đãi'))

      // 1. Non-numeric text
      fireEvent.change(screen.getByLabelText('Giá gốc'), { target: { value: 'invalid-price' } })
      fireEvent.click(screen.getByRole('button', { name: 'Lưu lịch khởi hành' }))
      expect(screen.getByRole('alert').textContent).toContain('giá gốc phải hợp lệ và lớn hơn giá bán')
      expect(onSubmit).not.toHaveBeenCalled()

      // 2. Original price equal to sale price (10M vs 10M)
      fireEvent.change(screen.getByLabelText('Giá gốc'), { target: { value: '10000000' } })
      fireEvent.click(screen.getByRole('button', { name: 'Lưu lịch khởi hành' }))
      expect(screen.getByRole('alert').textContent).toContain('giá gốc phải hợp lệ và lớn hơn giá bán')
      expect(onSubmit).not.toHaveBeenCalled()

      // 3. Original price lower than sale price (8M vs 10M)
      fireEvent.change(screen.getByLabelText('Giá gốc'), { target: { value: '8,000,000' } })
      fireEvent.click(screen.getByRole('button', { name: 'Lưu lịch khởi hành' }))
      expect(screen.getByRole('alert').textContent).toContain('giá gốc phải hợp lệ và lớn hơn giá bán')
      expect(onSubmit).not.toHaveBeenCalled()

      // 4. Strictly greater than sale price (12M > 10M) -> succeeds
      fireEvent.change(screen.getByLabelText('Giá gốc'), { target: { value: '12,000,000' } })
      fireEvent.click(screen.getByRole('button', { name: 'Lưu lịch khởi hành' }))
      await waitFor(() => {
        expect(onSubmit).toHaveBeenCalledWith(
          expect.objectContaining({
            originalPrice: '12000000',
            priceFrom: '10000000',
            promotionEnabled: true,
          }),
          'done',
        )
      })
    })

    it('allows label-only promotion without original price when promoLabel is provided', async () => {
      const onSubmit = vi.fn()
      render(
        <TourDepartureForm
          initial={defaultInitial}
          onCancel={vi.fn()}
          onSubmit={onSubmit}
        />,
      )

      fireEvent.click(screen.getByLabelText('Áp dụng ưu đãi'))
      fireEvent.change(screen.getByLabelText('Nhãn promotion'), { target: { value: 'Ưu đãi mùa hè' } })
      fireEvent.click(screen.getByRole('button', { name: 'Lưu lịch khởi hành' }))

      await waitFor(() => {
        expect(onSubmit).toHaveBeenCalledWith(
          expect.objectContaining({
            originalPrice: '',
            priceFrom: '10000000',
            promoLabel: 'Ưu đãi mùa hè',
            promotionEnabled: true,
          }),
          'done',
        )
      })
    })

    it('submits promotionEnabled:false, originalPrice:"", promoLabel:"" when disabled to clear promotion', async () => {
      const onSubmit = vi.fn()
      const initialWithPromo: DepartureFormValue = {
        ...defaultInitial,
        originalPrice: '14000000',
        promoLabel: 'Flash Sale',
        promotionEnabled: true,
      }

      render(
        <TourDepartureForm
          initial={initialWithPromo}
          onCancel={vi.fn()}
          onSubmit={onSubmit}
        />,
      )

      const toggle = screen.getByLabelText('Áp dụng ưu đãi') as HTMLInputElement
      expect(toggle.checked).toBe(true)

      // User unchecks promotion
      fireEvent.click(toggle)
      expect(toggle.checked).toBe(false)

      fireEvent.click(screen.getByRole('button', { name: 'Lưu lịch khởi hành' }))

      await waitFor(() => {
        expect(onSubmit).toHaveBeenCalledWith(
          expect.objectContaining({
            originalPrice: '',
            promoLabel: '',
            promotionEnabled: false,
          }),
          'done',
        )
      })
    })
  })

  describe('TourDepartureForm - Verification Reset on Commerce Edits', () => {
    it('resets verified to false and clears expiresAt whenever promotion or price fields change', () => {
      const verifiedInitial: DepartureFormValue = {
        ...defaultInitial,
        expiresAt: '2027-01-01T12:00',
        originalPrice: '15000000',
        promoLabel: 'Mùa thu',
        promotionEnabled: true,
        verified: true,
      }

      render(
        <TourDepartureForm
          initial={verifiedInitial}
          onCancel={vi.fn()}
          onSubmit={vi.fn()}
        />,
      )

      const verifyCheckbox = screen.getByLabelText(/Tôi xác nhận/) as HTMLInputElement
      expect(verifyCheckbox.checked).toBe(true)
      expect(screen.getByLabelText('Hết hạn xác minh')).toBeTruthy()

      // 1. Changing original price resets verification
      fireEvent.change(screen.getByLabelText('Giá gốc'), { target: { value: '16000000' } })
      expect(verifyCheckbox.checked).toBe(false)
      expect(screen.queryByLabelText('Hết hạn xác minh')).toBeNull()

      // Re-verify
      fireEvent.click(verifyCheckbox)
      fireEvent.change(screen.getByLabelText('Hết hạn xác minh'), { target: { value: '2027-01-01T12:00' } })
      expect(verifyCheckbox.checked).toBe(true)

      // 2. Changing promo label resets verification
      fireEvent.change(screen.getByLabelText('Nhãn promotion'), { target: { value: 'Mùa đông' } })
      expect(verifyCheckbox.checked).toBe(false)
      expect(screen.queryByLabelText('Hết hạn xác minh')).toBeNull()

      // Re-verify
      fireEvent.click(verifyCheckbox)
      fireEvent.change(screen.getByLabelText('Hết hạn xác minh'), { target: { value: '2027-01-01T12:00' } })
      expect(verifyCheckbox.checked).toBe(true)

      // 3. Toggling promotion off resets verification
      fireEvent.click(screen.getByLabelText('Áp dụng ưu đãi'))
      expect(verifyCheckbox.checked).toBe(false)
      expect(screen.queryByLabelText('Hết hạn xác minh')).toBeNull()

      // Re-verify
      fireEvent.click(verifyCheckbox)
      fireEvent.change(screen.getByLabelText('Hết hạn xác minh'), { target: { value: '2027-01-01T12:00' } })
      expect(verifyCheckbox.checked).toBe(true)

      // 4. Changing sale price resets verification
      fireEvent.change(screen.getByLabelText('Giá'), { target: { value: '11000000' } })
      expect(verifyCheckbox.checked).toBe(false)
      expect(screen.queryByLabelText('Hết hạn xác minh')).toBeNull()
    })
  })

