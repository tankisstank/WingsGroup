306	    new Date(left.nextDeparture.date).getTime() - new Date(right.nextDeparture.date).getTime()
307	  if (dateDelta !== 0) return dateDelta
308	  const titleDelta = left.title.localeCompare(right.title, 'vi')
309	  if (titleDelta !== 0) return titleDelta
310	  return String(left.id).localeCompare(String(right.id), 'en')
311	}
312	
313	export const selectWingsGoCatalogCards = ({
314	  cards,
315	  excludeIDs = [],
316	  filters = {},
317	  limit = WINGSGO_CATALOG_BATCH_SIZE,
318	  offset = 0,
319	}: {
320	  cards: WingsGoCatalogCard[]
321	  excludeIDs?: Array<number | string>
322	  filters?: WingsGoCatalogFilters
323	  limit?: number
324	  offset?: number
325	}) => {
326	  const boundedLimit = Math.min(Math.max(limit, 0), WINGSGO_CATALOG_BATCH_SIZE)
327	  const excluded = new Set(excludeIDs.map(String))
328	  const filtered = cards
329	    .filter((card) => !excluded.has(String(card.id)))
330	    .filter((card) => !filters.market || card.market === filters.market)
331	    .filter(
332	      (card) => filters.durationMin === undefined || card.duration.days >= filters.durationMin,
333	    )
334	    .filter(
335	      (card) => filters.durationMax === undefined || card.duration.days <= filters.durationMax,
336	    )
337	    .filter((card) => {
338	      const price = card.price.kind === 'verified' ? card.price.value : null
339	      return filters.priceMin === undefined || (price !== null && price >= filters.priceMin)
340	    })
341	    .filter((card) => {
342	      const price = card.price.kind === 'verified' ? card.price.value : null
343	      return filters.priceMax === undefined || (price !== null && price <= filters.priceMax)
344	    })
345	
346	  const seenIDs = new Set<string>()
347	  const deduped = filtered.filter((card) => {
348	    const key = String(card.id)
349	    if (seenIDs.has(key)) return false
350	    seenIDs.add(key)
351	    return true
352	  })
353	  deduped.sort((left, right) => compareCards(left, right, filters.sort || 'next-departure'))
354	
355	  return {
356	    cards: deduped.slice(offset, offset + boundedLimit),
357	    hasMore: offset + boundedLimit < deduped.length,
358	    total: deduped.length,
359	  }
360	}
361	
362	const readSearchParam = (source: SearchParamSource, key: string) => {
363	  if (source instanceof URLSearchParams) return source.get(key) || undefined
364	  const value = source[key]
365	  return Array.isArray(value) ? value[0] : value
366	}
367	
368	const parsePositiveNumber = (value?: string) => {
369	  if (!value || !/^\d+(?:\.\d+)?$/u.test(value)) return undefined
370	  const parsed = Number(value)
371	  return Number.isFinite(parsed) && parsed >= 0 ? parsed : undefined
372	}
373	
374	export const parseWingsGoCatalogFilters = (source: SearchParamSource): WingsGoCatalogFilters => {
375	  const sort = readSearchParam(source, 'sort')
376	  const durationMin = parsePositiveNumber(readSearchParam(source, 'durationMin'))
377	  const durationMax = parsePositiveNumber(readSearchParam(source, 'durationMax'))
378	  const priceMin = parsePositiveNumber(readSearchParam(source, 'priceMin'))
379	  const priceMax = parsePositiveNumber(readSearchParam(source, 'priceMax'))
380	
381	  return {
382	    ...(readSearchParam(source, 'market') ? { market: readSearchParam(source, 'market') } : {}),
383	    ...(durationMin === undefined ? {} : { durationMin }),
384	    ...(durationMax === undefined ? {} : { durationMax }),
385	    ...(priceMin === undefined ? {} : { priceMin }),
386	    ...(priceMax === undefined ? {} : { priceMax }),
387	    ...(sort === 'next-departure' || sort === 'price' || sort === 'title' ? { sort } : {}),
388	  }
389	}
390	
391	const queryDocs = async (
392	  payload: Payload,
393	  collection: 'pages' | 'tour-departures' | 'tour-products',
394	  where: unknown,
395	  locale?: string,
396	) =>
397	  payload.find({
398	    collection,
399	    depth: 2,
400	    draft: false,
401	    ...(locale ? { fallbackLocale: 'vi', locale: locale as never } : {}),
402	    limit: WINGSGO_CATALOG_MAX_INVENTORY,
403	    overrideAccess: true,
404	    pagination: false,
405	    where: where as never,
406	  })
407	
408	export const queryWingsGoTourCatalog = async ({
409	  filters = {},
410	  limit = WINGSGO_CATALOG_BATCH_SIZE,
411	  locale = 'vi',
412	  now = new Date(),
413	  offset = 0,
414	  page,
415	  payload,
416	  site,
417	}: {
418	  filters?: WingsGoCatalogFilters
419	  limit?: number
420	  locale?: string
421	  now?: Date
422	  offset?: number
423	  page: WingsGoCatalogPage
424	  payload: Payload
425	  site: { code: string; id: number | string }
426	}): Promise<WingsGoCatalogData> => {
427	  if (
428	    site.code !== 'wings-go' ||
429	    (!page.wingsGoTourCatalog?.enabled && page.pathname !== '/tour')
430	  ) {
431	    return { all: [], featured: [], hasMore: false, nextOffset: 0 }
432	  }
433	
434	  const wrapperResult = await queryDocs(
435	    payload,
436	    'pages',
437	    {
438	      and: [
439	        { _status: { equals: 'published' } },
440	        { site: { equals: site.id } },
441	        { pathname: { like: '/tour/%' } },
442	      ],
443	    },
444	    locale,
445	  )
446	  const wrappers = wrapperResult.docs as unknown as InventoryWrapper[]
447	  const wrapperIDs = wrappers.map((wrapper) => wrapper.id)
448	  if (wrapperIDs.length === 0) return { all: [], featured: [], hasMore: false, nextOffset: 0 }
449	
450	  const productsResult = await queryDocs(
451	    payload,
452	    'tour-products',
453	    {
454	      and: [
455	        { _status: { equals: 'published' } },
456	        { site: { equals: site.id } },
457	        { wrapperPage: { in: wrapperIDs } },
458	      ],
459	    },
460	    locale,
461	  )
462	  const products = productsResult.docs as unknown as InventoryProduct[]
463	  const productIDs = products.map((product) => product.id)
464	  if (productIDs.length === 0) return { all: [], featured: [], hasMore: false, nextOffset: 0 }
465	
466	  const departuresResult = await queryDocs(
467	    payload,
468	    'tour-departures',
469	    {
470	      and: [
471	        { _status: { equals: 'published' } },
472	        { site: { equals: site.id } },
473	        { tourProduct: { in: productIDs } },
474	        { departureDate: { greater_than: now.toISOString() } },
475	      ],
476	    },
477	    locale,
478	  )
479	  const departures = departuresResult.docs as unknown as InventoryDeparture[]
480	  const wrappersByID = new Map(wrappers.map((wrapper) => [String(wrapper.id), wrapper]))
481	  const departuresByProduct = new Map<string, InventoryDeparture[]>()
482	  for (const departure of departures) {
483	    const productID = relationID(departure.tourProduct)
484	    if (productID === null) continue
485	    const current = departuresByProduct.get(String(productID)) || []
486	    current.push(departure)
487	    departuresByProduct.set(String(productID), current)
488	  }
489	
490	  const cards = products
491	    .map((product) =>
492	      buildCard({
493	        departures: departuresByProduct.get(String(product.id)) || [],
494	        now,
495	        product,
496	        wrapper: wrappersByID.get(String(relationID(product.wrapperPage))) || null,
497	      }),
498	    )
499	    .filter((card): card is WingsGoCatalogCard => Boolean(card))
500	
501	  const configuredIDs = await resolveCuratedTourIDs({
502	    page,
503	    payload,
504	    siteID: site.id,
505	  })
506	  const configuredFeatured: WingsGoCatalogCard[] = []
507	  const configuredSeenIDs = new Set<string>()
508	  for (const id of configuredIDs) {
509	    const key = String(id)
510	    if (configuredSeenIDs.has(key)) continue
511	    const card = cards.find((candidate) => String(candidate.id) === key)
512	    if (card) {
513	      configuredSeenIDs.add(key)
514	      configuredFeatured.push(card)
515	    }
516	  }
517	  const fallback = selectWingsGoCatalogCards({
518	    cards,
519	    excludeIDs: configuredFeatured.map((card) => card.id),
520	    filters: {},
521	  }).cards
522	  const featured = [...configuredFeatured, ...fallback].slice(0, WINGSGO_CATALOG_MAX_FEATURED)
523	  const featuredIDs = featured.map((card) => card.id)
524	  const all = selectWingsGoCatalogCards({ cards, excludeIDs: featuredIDs, filters, limit, offset })
525	
526	  return {
527	    all: all.cards,
528	    featured,
529	    hasMore: all.hasMore,
530	    nextOffset: offset + all.cards.length,
531	  }
532	}
