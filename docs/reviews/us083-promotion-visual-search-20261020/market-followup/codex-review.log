import { formatTourPrice } from './utils'

export const isDisplayablePromoLabel = (value: unknown): value is string => {
  if (typeof value !== 'string') return false
  const label = value.trim()
  return Boolean(label) && !/^\d[\d\s.,-]*$/.test(label)
}

export function PromotionBadge({ label }: { label?: null | string }) {
  if (!isDisplayablePromoLabel(label)) return null

  return (
    <span className="inline-flex max-w-full w-fit break-words rounded-full bg-gradient-to-r from-orange-500 to-amber-500 px-3 py-1 text-xs font-bold text-white shadow-md [overflow-wrap:anywhere]">
      {label.trim()}
    </span>
  )
}

export function PromotionPrice({
  currency,
  contactLabel = 'Liên hệ',
  originalPrice,
  price,
}: {
  currency?: null | string
  contactLabel?: string
  originalPrice?: null | number
  price?: null | number
}) {
  const salePrice = Number.isFinite(price) && Number(price) > 0 ? Number(price) : 0
  const saleLabel = formatTourPrice(salePrice, currency)
  const originalLabel = formatTourPrice(originalPrice, currency)
  const hasDiscount = Boolean(saleLabel && originalLabel && Number(originalPrice) > salePrice)

  return (
    <span className="inline-flex flex-wrap items-baseline gap-x-2 gap-y-1">
      {hasDiscount ? (
        <del className="text-sm font-normal text-muted-foreground">{originalLabel}</del>
      ) : null}
      <span className={hasDiscount ? 'font-extrabold text-red-600 dark:text-red-400' : undefined}>
        {saleLabel || contactLabel}
      </span>
    </span>
  )
}
export const supportedTourCurrencyCodes = ['VND', 'USD'] as const

export type SupportedTourCurrencyCode = (typeof supportedTourCurrencyCodes)[number]

export const supportedTourCurrencyOptions = supportedTourCurrencyCodes.map((currency) => ({
  label: currency,
  value: currency,
}))

export const normalizeSupportedTourCurrency = (
  value: unknown,
): SupportedTourCurrencyCode | null => {
  if (typeof value !== 'string') return null

  const currency = value.trim().toUpperCase()
  return supportedTourCurrencyCodes.includes(currency as SupportedTourCurrencyCode)
    ? (currency as SupportedTourCurrencyCode)
    : null
}
export type GovernedTourPrice = {
  currency: SupportedTourCurrencyCode
  value: number
}

export const normalizeGovernedTourPrice = ({
  currency,
  value,
}: {
  currency: unknown
  value: unknown
}): GovernedTourPrice | null => {
  const normalizedCurrency = normalizeSupportedTourCurrency(currency)

  return typeof value === 'number' &&
    Number.isFinite(value) &&
    value > 0 &&
    normalizedCurrency
    ? { currency: normalizedCurrency, value }
    : null
}
import type { CollectionBeforeValidateHook } from 'payload'

type Relation = number | string | { id?: number | string | null } | null | undefined

export type GovernedDepartureFreshness = {
  expiresAt?: null | string
  verifiedAt?: null | string
}

const relationID = (value: Relation): number | string | null => {
  if (typeof value === 'number' || typeof value === 'string') return value
  if (value && (typeof value.id === 'number' || typeof value.id === 'string')) return value.id
  return null
}

const dateOnlyUTC = (value: unknown): string | null => {
  const date = new Date(String(value || ''))
  if (!Number.isFinite(date.getTime())) return null
  return date.toISOString().slice(0, 10)
}

const normalizeVariantKey = (value: unknown): string | null => {
  const normalized = String(value || '')
    .normalize('NFKC')
    .trim()
    .toLowerCase()
    .replace(/\s+/gu, '-')
  return normalized || null
}

export const buildDepartureInventoryIdentity = ({
  departureDate,
  site,
  tourProduct,
  variantKey,
  variantRef,
}: {
  departureDate?: unknown
  site?: Relation
  tourProduct?: Relation
  variantKey?: unknown
  variantRef?: Relation
}): string | null => {
  const siteID = relationID(site)
  const tourID = relationID(tourProduct)
  const date = dateOnlyUTC(departureDate)
  if (siteID == null || tourID == null || !date) return null

  const variantID = relationID(variantRef)
  const normalizedVariantKey = normalizeVariantKey(variantKey)
  const variant =
    variantID != null
      ? `ref:${variantID}`
      : normalizedVariantKey
        ? `key:${normalizedVariantKey}`
        : 'base'

  return `s:${siteID}|t:${tourID}|d:${date}|v:${variant}`
}

/**
 * Price, departure and availability claims are visible only inside a current
 * verification window. Expiry does not remove the tour or its contact fallback.
 */
export const isDepartureVerificationCurrent = (
  departure: GovernedDepartureFreshness,
  now = Date.now(),
): boolean => {
  const verifiedAt = Date.parse(departure.verifiedAt || '')
  const expiresAt = Date.parse(departure.expiresAt || '')
  return (
    Number.isFinite(verifiedAt) &&
    Number.isFinite(expiresAt) &&
    verifiedAt <= now &&
    expiresAt > now &&
    verifiedAt < expiresAt
  )
}

export const setDepartureInventoryIdentity: CollectionBeforeValidateHook = ({
  data,
  originalDoc,
}) => {
  if (!data) return data
  const merged = { ...(originalDoc || {}), ...data }
  return {
    ...data,
    inventoryIdentity: buildDepartureInventoryIdentity({
      departureDate: merged.departureDate,
      site: merged.site,
      tourProduct: merged.tourProduct,
      variantKey: merged.variantKey,
      variantRef: merged.variantRef,
    }),
  }
}

