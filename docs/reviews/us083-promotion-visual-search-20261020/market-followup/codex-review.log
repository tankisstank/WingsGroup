```typescript
1	const maxReportBytes = 16 * 1024
2	
3	const bounded = (value: unknown): string | undefined =>
4	  typeof value === 'string' ? value.slice(0, 256) : undefined
5	
6	const safeOrigin = (value: unknown): string | undefined => {
7	  if (typeof value !== 'string') return undefined
8	  try {
9	    return new URL(value).origin.slice(0, 256)
10	  } catch {
11	    return bounded(value)
12	  }
13	}
14	
15	const knownDirectives = new Set([
16	  'base-uri',
17	  'child-src',
18	  'connect-src',
19	  'default-src',
20	  'font-src',
21	  'form-action',
22	  'frame-ancestors',
23	  'frame-src',
24	  'img-src',
25	  'media-src',
26	  'object-src',
27	  'script-src',
28	  'script-src-attr',
29	  'script-src-elem',
30	  'style-src',
31	  'style-src-attr',
32	  'style-src-elem',
33	  'worker-src',
34	])
35	
36	const safeDirectiveLabel = (value: unknown): string => {
37	  const directive = bounded(value)
38	  if (!directive) return 'unknown'
39	  const normalized = directive.toLowerCase()
40	  return knownDirectives.has(normalized) ? normalized : 'other'
41	}
42	
43	export async function POST(request: Request): Promise<Response> {
44	  const contentType = request.headers.get('content-type') || ''
45	  if (!/application\/(?:csp-report|reports\+json|json)/i.test(contentType)) {
46	    return new Response(null, { status: 415 })
47	  }
48	
49	  const body = await request.text()
50	  if (Buffer.byteLength(body, 'utf8') > maxReportBytes) {
51	    return new Response(null, { status: 413 })
52	  }
53	
54	  try {
55	    const parsed = JSON.parse(body)
56	    const rawReport = Array.isArray(parsed) ? parsed[0]?.body : parsed?.['csp-report'] || parsed
57	    if (rawReport && typeof rawReport === 'object') {
58	      const report = rawReport as Record<string, unknown>
59	      incrementMetric('wingstravel_csp_reports_total', {
60	        directive: safeDirectiveLabel(report['effective-directive'] || report.effectiveDirective),
61	      })
62	      logOperationalEvent('warn', 'csp_violation', {
63	        blockedOrigin: safeOrigin(report['blocked-uri'] || report.blockedURL),
64	        directive: bounded(report['effective-directive'] || report.effectiveDirective),
65	        documentOrigin: safeOrigin(report['document-uri'] || report.documentURL),
66	        sourceFileOrigin: safeOrigin(report['source-file'] || report.sourceFile),
67	      })
68	    }
69	  } catch {
70	    return new Response(null, { status: 400 })
71	  }
72	
73	  return new Response(null, {
74	    headers: { 'Cache-Control': 'no-store' },
75	    status: 204,
76	  })
77	}
78	
79	export function GET(): Response {
80	  return new Response(null, { status: 405 })
81	}
82	import { incrementMetric, logOperationalEvent } from '@/observability'
