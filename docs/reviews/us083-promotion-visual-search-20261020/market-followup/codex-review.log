430	  ) {
431	    return { all: [], featured: [], hasMore: false, nextOffset: 0 }
432	  }
433	
434	  const wrapperResult = await queryDocs(
435	    payload,
436	    'pages',
437	    {
438	      and: [
439	        { _status: { equals: 'published' } },
440	        { site: { equals: site.id } },
441	        { pathname: { like: '/tour/%' } },
442	      ],
443	    },
444	    locale,
445	  )
446	  const wrappers = wrapperResult.docs as unknown as InventoryWrapper[]
447	  const wrapperIDs = wrappers.map((wrapper) => wrapper.id)
448	  if (wrapperIDs.length === 0) return { all: [], featured: [], hasMore: false, nextOffset: 0 }
449	
450	  const productsResult = await queryDocs(
451	    payload,
452	    'tour-products',
453	    {
454	      and: [
455	        { _status: { equals: 'published' } },
456	        { site: { equals: site.id } },
457	        { wrapperPage: { in: wrapperIDs } },
458	      ],
459	    },
460	    locale,
461	  )
462	  const products = productsResult.docs as unknown as InventoryProduct[]
463	  const productIDs = products.map((product) => product.id)
464	  if (productIDs.length === 0) return { all: [], featured: [], hasMore: false, nextOffset: 0 }
465	
466	  const departuresResult = await queryDocs(
467	    payload,
468	    'tour-departures',
469	    {
470	      and: [
471	        { _status: { equals: 'published' } },
472	        { site: { equals: site.id } },
473	        { tourProduct: { in: productIDs } },
474	        { departureDate: { greater_than: now.toISOString() } },
475	      ],
476	    },
477	    locale,
478	  )
479	  const departures = departuresResult.docs as unknown as InventoryDeparture[]
480	  const wrappersByID = new Map(wrappers.map((wrapper) => [String(wrapper.id), wrapper]))
481	  const departuresByProduct = new Map<string, InventoryDeparture[]>()
482	  for (const departure of departures) {
483	    const productID = relationID(departure.tourProduct)
484	    if (productID === null) continue
485	    const current = departuresByProduct.get(String(productID)) || []
486	    current.push(departure)
487	    departuresByProduct.set(String(productID), current)
488	  }
489	
490	  const cards = products
491	    .map((product) =>
492	      buildCard({
493	        departures: departuresByProduct.get(String(product.id)) || [],
494	        now,
495	        product,
496	        wrapper: wrappersByID.get(String(relationID(product.wrapperPage))) || null,
497	      }),
498	    )
499	    .filter((card): card is WingsGoCatalogCard => Boolean(card))
500	
501	  const configuredIDs = await resolveCuratedTourIDs({
502	    page,
503	    payload,
504	    siteID: site.id,
505	  })
506	  const configuredFeatured: WingsGoCatalogCard[] = []
507	  const configuredSeenIDs = new Set<string>()
508	  for (const id of configuredIDs) {
509	    const key = String(id)
510	    if (configuredSeenIDs.has(key)) continue
511	    const card = cards.find((candidate) => String(candidate.id) === key)
512	    if (card) {
513	      configuredSeenIDs.add(key)
514	      configuredFeatured.push(card)
515	    }
516	  }
517	  const fallback = selectWingsGoCatalogCards({
518	    cards,
519	    excludeIDs: configuredFeatured.map((card) => card.id),
520	    filters: {},
521	  }).cards
522	  const featured = [...configuredFeatured, ...fallback].slice(0, WINGSGO_CATALOG_MAX_FEATURED)
523	  const featuredIDs = featured.map((card) => card.id)
524	  const all = selectWingsGoCatalogCards({ cards, excludeIDs: featuredIDs, filters, limit, offset })
525	
526	  return {
527	    all: all.cards,
528	    featured,
529	    hasMore: all.hasMore,
530	    nextOffset: offset + all.cards.length,
531	  }
532	}
