534	export const resolveCuratedTourIDs = async ({
535	  page,
536	  payload,
537	  siteID,
538	}: {
539	  page?: WingsGoCatalogPage | null
540	  payload: Payload
541	  siteID: number | string
542	}): Promise<Array<number | string>> => {
543	  // Tier 1: Page-bound curation
544	  const pageCurationRef = page?.wingsGoTourCatalog?.curation
545	  if (pageCurationRef) {
546	    if (
547	      typeof pageCurationRef === 'object' &&
548	      pageCurationRef !== null &&
549	      'featuredTours' in pageCurationRef &&
550	      Array.isArray((pageCurationRef as { featuredTours?: unknown }).featuredTours)
551	    ) {
552	      const pageCurationSite = relationID((pageCurationRef as { site?: Relation }).site)
553	      if (!pageCurationSite || String(pageCurationSite) === String(siteID)) {
554	        const ids = relationIDs((pageCurationRef as { featuredTours?: unknown }).featuredTours)
555	        if (ids.length > 0) return ids
556	      }
557	    }
558	    const curationID = relationID(pageCurationRef as Relation)
559	    if (curationID) {
560	      try {
561	        const curationDoc = await payload.findByID({
562	          collection: 'tour-curations',
563	          depth: 0,
564	          id: curationID,
565	          overrideAccess: true,
566	        })
567	        if (curationDoc) {
568	          const curationSite = relationID((curationDoc as { site?: Relation }).site)
569	          if (!curationSite || String(curationSite) === String(siteID)) {
570	            const ids = relationIDs((curationDoc as { featuredTours?: unknown }).featuredTours)
571	            if (ids.length > 0) return ids
572	          }
573	        }
574	      } catch {
575	        // Fallback to Tier 2
576	      }
577	    }
578	  }
579	
580	  // Tier 2: Site default curation
581	  try {
582	    const defaultCurationResult = await payload.find({
583	      collection: 'tour-curations',
584	      depth: 0,
585	      limit: 1,
586	      overrideAccess: true,
587	      pagination: false,
588	      where: {
589	        and: [{ site: { equals: siteID } }, { isDefault: { equals: true } }],
590	      },
591	    })
592	    const defaultDoc = defaultCurationResult.docs[0]
593	    if (defaultDoc) {
594	      const ids = relationIDs((defaultDoc as { featuredTours?: unknown }).featuredTours)
595	      if (ids.length > 0) return ids
596	    }
597	  } catch {
598	    // Fallback to Tier 3
599	  }
600	
601	  // Tier 3: Legacy featuredTours array on page
602	  const legacyIDs = relationIDs(page?.wingsGoTourCatalog?.featuredTours)
603	  if (legacyIDs.length > 0) {
604	    return legacyIDs
605	  }
606	
607	  // Tier 4: Algorithmic fallback
608	  return []
609	}
