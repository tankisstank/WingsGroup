# Database connection string.
# Local/test may use SQLite: file:./payload-tourplatform.db
# Staging/production must use PostgreSQL: postgresql://payload:payload@postgres:5432/wingstravel
DATABASE_URL=file:./payload-tourplatform.db

# SQLite only: opt in when intentionally bootstrapping or changing the local schema.
# Keep false during normal development to avoid interactive schema prompts.
PAYLOAD_DB_PUSH=false

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Server-only HMAC key for cross-domain preview handoffs. It must be present
# in every deployment that serves an admin or child-site domain.
PREVIEW_HANDOFF_SECRET=YOUR_SERVER_ONLY_SECRET_HERE

# Comma-separated, server-only allowlist. The CMS Site record is deliberately
# not used as a preview redirect target, so stale local seed domains cannot
# send production editors to a non-existent host.
PREVIEW_PUBLIC_ORIGINS=wings-group=wingsgroup.vn,wings-go=wingsgo.vn,wing-side=wingside.vn,wings-pass=wingspass.wingsgroup.vn,wings-plus=wingsplus.vn,wings-care=wingscare.wingsgroup.vn

# Server-only HMAC key for the bounded local draft-preview grant.
LOCAL_PREVIEW_GRANT_SECRET=YOUR_SERVER_ONLY_SECRET_HERE

# Optional production-scale cache/KV support layer.
REDIS_URL=redis://redis:6379
