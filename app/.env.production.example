# WingsGroup production VPS example.
# Copy to your server secret store or .env file and replace every CHANGE_ME value.

NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://wingsgroup:CHANGE_ME_DB_PASSWORD@postgres:5432/wingsgroup
PAYLOAD_DB_PUSH=false
PAYLOAD_SECRET=CHANGE_ME_PAYLOAD_SECRET
NEXT_PUBLIC_SERVER_URL=https://CHANGE_ME_PRIMARY_DOMAIN
CRON_SECRET=CHANGE_ME_CRON_SECRET
PREVIEW_SECRET=CHANGE_ME_PREVIEW_SECRET
LOCAL_PREVIEW_GRANT_SECRET=CHANGE_ME_LOCAL_PREVIEW_GRANT_SECRET

# Redis is included in the VPS stack as production-ready cache/KV support.
REDIS_URL=redis://redis:6379

# Current Phase 1 email mode is console-only.
# Add SMTP/API provider variables only after the customer chooses an email service.
